# GreenGrid Environment Variables
# Copy this file to .env and fill in real values.
# The real .env is gitignored; never commit secrets.

# ── Random seed override ──────────────────────────────────────────────────────
# Overrides config.yaml project.seed at runtime. Useful for reproducible CI runs.
GREENGRID_SEED=42

# ── Logging ───────────────────────────────────────────────────────────────────
# Loguru log level: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Airflow (only needed when running the Airflow service) ────────────────────
# See: https://airflow.apache.org/docs/apache-airflow/stable/configurations-ref.html
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/app/airflow/dags
# AIRFLOW__CORE__FERNET_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////app/airflow/airflow.db
